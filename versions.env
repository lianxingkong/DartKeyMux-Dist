# =============================================================================
#  DartKeyMux-Dist 版本对齐表 —— 本仓库唯一需要人工维护的文件
# =============================================================================
#  改完这里推 main，CI 会自动校验两个 tag 是否真实存在、资产名是否对得上。
#  打 git tag 时，tag 名会覆盖 PACKAGE_VERSION（见 .github/workflows/release.yml）。
# -----------------------------------------------------------------------------

# 前端（Flutter App）：产物是 app-release.apk
# 注意：前端代码位于 DartKeyMux 仓库的 flutter_application_1/ 子目录
FRONTEND_REPO="lianxingkong/DartKeyMux"
FRONTEND_TAG="v1.1.2"
FRONTEND_ASSET="app-release.apk"

# 后端（Go 服务）:产物是 GoKeyMux-windows-<arch>.zip（内含 GoKeyMux.exe + Interception/ + proto/）
# 端口约定：gRPC 监听 50051，App 与后端双方都硬编码 50051（见 DartKeyMux/lib/app_config.dart
#           与 GoKeyMux/config.go 的 GRPCAddress 默认值 "localhost:50051"）
BACKEND_REPO="com-wuqi/GoKeyMux"
BACKEND_TAG="v0.1.2"

# 后端 release 资产名的模板，{arch} 由 assemble.sh 替换成 amd64 / 386
BACKEND_ASSET_TEMPLATE="GoKeyMux-windows-{arch}.zip"

# FakerInput 输入引擎驱动安装包（仅 amd64 资产内含，386 资产不含）
FAKERINPUT_MSI="FakerInput_Setup_0.1.1_x64.msi"

# 打包版本号：产物名 app-<PACKAGE_VERSION>-windows-<arch>.zip
PACKAGE_VERSION="v1.0.0"
